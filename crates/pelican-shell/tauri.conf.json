{
  "productName": "Pelican",
  "version": "0.2.1",
  "identifier": "io.github.n0ble-s1x.pelican",
  "mainBinaryName": "pelican-app",
  "build": {
    "frontendDist": "../../ui",
    "beforeBuildCommand": {
      "script": "cargo build --release --locked -p pelican",
      "cwd": "../.."
    },
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pelican",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#050506",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'none'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"],
    "category": "Music",
    "shortDescription": "Put music on a Garmin watch, and prove it arrived.",
    "longDescription": "Pelican sends music from this computer to a Garmin watch over USB and reads every file back to prove it arrived intact. No account, no network, no telemetry.",
    "publisher": "Krypteia Security",
    "homepage": "https://github.com/n0ble-s1x/pelican",
    "license": "MIT OR Apache-2.0",
    "copyright": "Copyright (c) 2026 Krypteia Security LLC",
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/io.github.n0ble_s1x.Pelican.svg": "../../packaging/icons/io.github.n0ble_s1x.Pelican.svg"
        }
      }
    }
  }
}
