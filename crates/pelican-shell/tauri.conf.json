{
  "productName": "Pelican",
  "version": "0.1.0",
  "identifier": "com.krypteia.pelican",
  "mainBinaryName": "pelican-app",
  "build": {
    "frontendDist": "../../ui",
    "beforeBuildCommand": {
      "script": "cargo build --release --locked -p pelican",
      "cwd": "../.."
    },
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pelican",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#050506",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'none'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Music",
    "shortDescription": "Put music on a Garmin watch, and prove it arrived.",
    "longDescription": "Pelican sends music from this computer to a Garmin watch over USB and reads every file back to prove it arrived intact. No account, no network, no telemetry.",
    "publisher": "Krypteia",
    "homepage": "https://github.com/n0ble-s1x/pelican",
    "license": "MIT OR Apache-2.0",
    "copyright": "Copyright (c) 2026 Krypteia LLC",
    "linux": {
      "deb": {
        "depends": ["ffmpeg"],
        "section": "sound",
        "desktopTemplate": "../../packaging/desktop/com.krypteia.Pelican.desktop",
        "postInstallScript": "../../packaging/deb/postinst",
        "files": {
          "/usr/bin/pelican": "../../target/release/pelican",
          "/usr/lib/udev/rules.d/70-garmin-mtp.rules": "../../udev/70-garmin-mtp.rules",
          "/usr/share/icons/hicolor/scalable/apps/com.krypteia.Pelican.svg": "../../packaging/icons/com.krypteia.Pelican.svg",
          "/usr/share/doc/pelican/README.md": "../../README.md",
          "/usr/share/doc/pelican/LICENSE-MIT": "../../LICENSE-MIT",
          "/usr/share/doc/pelican/LICENSE-APACHE": "../../LICENSE-APACHE"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/com.krypteia.Pelican.svg": "../../packaging/icons/com.krypteia.Pelican.svg"
        }
      }
    }
  }
}
